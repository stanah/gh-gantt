{
  "name": "@gh-gantt/cli",
  "version": "0.2.1-alpha",
  "private": true,
  "bin": {
    "gh-gantt": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test run --exclude 'src/__tests__/e2e-sync.test.ts'",
    "test:json": "vp test run --exclude 'src/__tests__/e2e-sync.test.ts' --reporter=default --reporter=json --outputFile=../../test-results-cli.json",
    "test:e2e-sync": "vp test run src/__tests__/e2e-sync.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@gh-gantt/shared": "workspace:*",
    "@octokit/graphql": "^8.2.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "playwright": "^1.63.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "typescript": "^5.9.3",
    "vite-plus": "^0.3.0"
  }
}
