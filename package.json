{
  "name": "gh-gantt",
  "version": "0.2.1-alpha",
  "private": true,
  "description": "GitHub Projects Gantt chart with hierarchical progress tracking",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev & gh-gantt serve --api-only & wait",
    "lint": "git ls-files -z -- . ':(exclude)CHANGELOG.md' ':(exclude)packages/*/CHANGELOG.md' | xargs -0 vp check",
    "test": "pnpm test:workflow && pnpm -r test",
    "test:workflow": "vp test run tests/**/*.test.ts --exclude '.claude/**' --exclude '.worktrees/**'",
    "test:workflow:json": "vp test run tests/**/*.test.ts --exclude '.claude/**' --exclude '.worktrees/**' --reporter=default --reporter=json --outputFile=test-results-workflow.json",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:json": "pnpm test:workflow:json && pnpm -r test:json",
    "typecheck": "pnpm -r typecheck",
    "smoke:personal": "pnpm --filter @gh-gantt/smoke smoke:personal",
    "smoke:org": "pnpm --filter @gh-gantt/smoke smoke:org",
    "benchmark:graph": "pnpm --filter @gh-gantt/smoke benchmark:graph",
    "docs:gen": "tsx scripts/docs-gen.ts",
    "req:trace": "tsx scripts/req-trace.ts",
    "req:validate": "tsx scripts/req-validate.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@gh-gantt/shared": "workspace:*",
    "@playwright/test": "^1.63.0",
    "lefthook": "^2.1.12",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "vite-plus": "^0.3.0",
    "vitest": "4.1.11",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
